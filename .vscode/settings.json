{
  // Python của dự án (giống lệnh .venv/Scripts/python.exe -I trong CLAUDE.md)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // Giữ cây thư mục và tìm kiếm gọn
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    ".venv": true,
    "work/pose_lab/models": true,
    "work/boss_gaygor/idle/original": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/work/pose_lab/models/**": true
  },

  // Dòng mới LF cho file văn bản, khớp .gitattributes
  "files.eol": "\n",
  "files.encoding": "utf8"
}
