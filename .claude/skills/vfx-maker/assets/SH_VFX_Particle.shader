// Lightweight mobile particle shader for Built-in and URP (generated by vfx-maker).
// Single unlit pass without LightMode: Built-in draws it in forward, URP draws it as SRPDefaultUnlit.
// Uses UnityCG.cginc only (no URP includes) so it compiles in projects without URP. Not SRP Batcher compatible.
Shader "VFX/Particle Basic"
{
    Properties
    {
        _MainTex ("Texture", 2D) = "white" {}
        [HDR] _TintColor ("Tint", Color) = (1,1,1,1)
        [Toggle(_GRAYSCALE_R)] _UseR ("Use R as Alpha (grayscale on black)", Float) = 0

        [Toggle(_DISSOLVE)] _Dissolve ("Dissolve (threshold = Custom1.x)", Float) = 0
        _DissolveTex ("Dissolve Noise", 2D) = "gray" {}
        _DissolveEdge ("Dissolve Edge Width", Range(0.001, 0.5)) = 0.05
        [HDR] _EdgeColor ("Dissolve Edge Color", Color) = (1,0.5,0.1,1)

        [Enum(UnityEngine.Rendering.BlendMode)] _SrcBlend ("Src Blend", Float) = 5   // SrcAlpha
        [Enum(UnityEngine.Rendering.BlendMode)] _DstBlend ("Dst Blend", Float) = 1   // One = additive, 10 = alpha blend
        [Enum(UnityEngine.Rendering.CullMode)] _Cull ("Cull", Float) = 0
    }

    SubShader
    {
        Tags { "Queue"="Transparent" "RenderType"="Transparent" "IgnoreProjector"="True" "PreviewType"="Plane" }
        Blend [_SrcBlend] [_DstBlend]
        ZWrite Off
        Cull [_Cull]

        Pass
        {
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #pragma target 2.0
            #pragma shader_feature_local _GRAYSCALE_R
            #pragma shader_feature_local _DISSOLVE
            #include "UnityCG.cginc"

            sampler2D _MainTex;
            float4 _MainTex_ST;
            half4 _TintColor;
            sampler2D _DissolveTex;
            float4 _DissolveTex_ST;
            half _DissolveEdge;
            half4 _EdgeColor;

            struct appdata
            {
                float4 vertex : POSITION;
                fixed4 color : COLOR;
                float3 uv : TEXCOORD0;   // xy = UV, z = Custom1.x (when the custom vertex stream is enabled)
            };

            struct v2f
            {
                float4 pos : SV_POSITION;
                fixed4 color : COLOR;
                float3 uv : TEXCOORD0;
            };

            v2f vert (appdata v)
            {
                v2f o;
                o.pos = UnityObjectToClipPos(v.vertex);
                o.color = v.color;
                o.uv = float3(TRANSFORM_TEX(v.uv.xy, _MainTex), v.uv.z);
                return o;
            }

            half4 frag (v2f i) : SV_Target
            {
                half4 tex = tex2D(_MainTex, i.uv.xy);
            #if _GRAYSCALE_R
                tex = half4(1, 1, 1, tex.r);
            #endif
                half4 col = tex * _TintColor * i.color;

            #if _DISSOLVE
                half noise = tex2D(_DissolveTex, i.uv.xy * _DissolveTex_ST.xy + _DissolveTex_ST.zw).r;
                half remain = noise - i.uv.z;
                half active = step(0.001, i.uv.z);   // threshold 0 = no dissolve
                half edge = (1 - saturate(remain / _DissolveEdge)) * active;
                col.rgb = lerp(col.rgb, _EdgeColor.rgb, edge);
                col.a *= lerp(1, saturate(remain * 50 + 0.5), active);   // soft cut instead of discard (cheaper on tile-based GPUs)
            #endif
                return col;
            }
            ENDCG
        }
    }
}
