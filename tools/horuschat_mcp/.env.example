# Chép thành .env (cùng thư mục) rồi điền. File .env không lên git.
# Key: HorusChat > Settings > API Keys > tạo key, chọn scope
#   messages:read, messages:send, rooms:read, users:read (thêm rooms:write nếu cần join/rời phòng).
# Token chỉ hiện MỘT lần, chép ngay vào đây.
HORUSCHAT_BASE_URL=https://chat.horusjsc.com
HORUSCHAT_API_KEY=
# Phòng để horuschat_watch canh (room id !... hoặc tên phòng, cách nhau dấu phẩy). Để trống = chưa canh.
HORUSCHAT_WATCH=
