# Copy thành .env (cùng thư mục) rồi điền. File .env không lên git.
# Token: Rocket.Chat > Avatar > My Account (Tài khoản) > Personal Access Tokens > Add.
# Khi tạo token Rocket.Chat hiện cả Token và User ID, chép cả hai vào đây.
ROCKETCHAT_URL=https://chat.example.com
ROCKETCHAT_USER_ID=
ROCKETCHAT_TOKEN=
# Kênh để rocketchat_watch.py canh góp ý (tên kênh không có #, cách nhau bằng dấu phẩy)
ROCKETCHAT_WATCH=
